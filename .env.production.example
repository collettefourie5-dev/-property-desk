# Copy to .env.production on the PRODUCTION VM only (docker-compose.prod.yml reads this file).
# Every secret below must be its own strong, unique value — never reuse TEST secrets here.

NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

POSTGRES_DB=property_desk_production
POSTGRES_USER=property_desk_production
POSTGRES_PASSWORD=replace-with-a-strong-unique-production-password
DATABASE_URL=postgresql://property_desk_production:replace-with-a-strong-unique-production-password@postgres:5432/property_desk_production

BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=https://thepropertydesk.example
NEXT_PUBLIC_APP_URL=https://thepropertydesk.example

STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=property-desk-production
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

EMAIL_DRIVER=resend
EMAIL_FROM=bookings@thepropertydesk.example
ADMIN_NOTIFICATION_EMAIL=collette@crawfordharris.co.za
RESEND_API_KEY=

# Pixel ID is not secret (it's embedded in every page's HTML); the CAPI access token is secret —
# generate it in Meta Events Manager > Settings > Conversions API and put it here, never in git.
META_PIXEL_ID=2907959002919607
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

ZAPIER_WEBHOOK_URL=

# --- Site details shown publicly — runtime vars, no rebuild needed ---
ATTORNEY_NAME=Collette Fourie
FIRM_NAME=Crawford Harris Inc.
CONTACT_EMAIL=
