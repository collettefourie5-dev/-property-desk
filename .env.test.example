# Copy to .env.test for the TEST VM / CI (docker-compose.test.yml reads this file).
# Points at the dedicated TEST database — never the production one.

NODE_ENV=production
APP_ENV=test
LOG_LEVEL=info

POSTGRES_DB=property_desk_test
POSTGRES_USER=property_desk_test
POSTGRES_PASSWORD=replace-with-a-strong-test-password
DATABASE_URL=postgresql://property_desk_test:replace-with-a-strong-test-password@postgres:5432/property_desk_test

BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=https://test.thepropertydesk.example
NEXT_PUBLIC_APP_URL=https://test.thepropertydesk.example

STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=property-desk-test
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

EMAIL_DRIVER=resend
EMAIL_FROM=bookings@thepropertydesk.example
ADMIN_NOTIFICATION_EMAIL=collette@crawfordharris.co.za
RESEND_API_KEY=

# Left blank deliberately: TEST traffic (staff clicking around, E2E runs) would otherwise fire
# real PageView/Lead/Schedule events against the live ad account's pixel data. If you want to
# verify tracking end-to-end here, use the same production Pixel ID (2907959002919607) together
# with META_TEST_EVENT_CODE from Meta's Test Events tool, so test hits are clearly marked.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

ZAPIER_WEBHOOK_URL=

# --- Site details shown publicly — runtime vars, no rebuild needed ---
ATTORNEY_NAME=Collette Fourie
FIRM_NAME=Crawford Harris Inc.
CONTACT_EMAIL=
