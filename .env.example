# Copy to .env for local development (docker-compose.yml reads this file too).
# Never commit the real .env — only this template.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Must match POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD below when using docker-compose.yml.
POSTGRES_DB=property_desk
POSTGRES_USER=property_desk
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://property_desk:change-me-locally@localhost:5432/property_desk

# --- Better Auth --------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- File storage (booking document uploads) ---------------------------------
# "local" is dev/test only — never use it in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# S3-compatible (Cloudflare R2 / MinIO / AWS S3), required when STORAGE_DRIVER=s3:
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

# --- Email ---------------------------------------------------------------------
# "console" just logs emails during local dev — set to resend or smtp for real sending.
EMAIL_DRIVER=console
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false


# --- Meta Pixel / Conversions API ------------------------------------------------
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# --- Outbound automation (Seller Transaction Sheet, e.g. Zapier/Make) ------------
ZAPIER_WEBHOOK_URL=

# --- Site details shown publicly (LPC/compliance) — runtime vars, no rebuild needed ---
ATTORNEY_NAME=Collette Fourie
LPC_ADMISSION=
FIRM_NAME=
CONTACT_EMAIL=
